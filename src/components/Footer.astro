---
import { site } from '../data/site';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container site-footer__inner">
    <div class="site-footer__brand">
      <img src="/images/logo-azeo.png" alt="Azéo Conseil" width="126" height="44" loading="lazy" />
      <p>
        Intégrateur <a href={site.partners.horoquartz} rel="noopener">Horoquartz</a> ·
        Hébergement avec Exodata
      </p>
    </div>
    <ul class="site-footer__links">
      <li><a href="/mentions-legales/">Mentions légales</a></li>
      <li><a href="/confidentialite/">Confidentialité</a></li>
      {site.linkedin && <li><a href={site.linkedin} rel="noopener">LinkedIn</a></li>}
    </ul>
    <p class="site-footer__copy">© {year} {site.name}</p>
  </div>
</footer>

<style>
  .site-footer {
    padding-block: 40px;
    color: var(--muted);
    font-size: 0.9375rem;
  }
  .site-footer__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 20px 40px;
  }
  .site-footer__brand {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .site-footer__brand img {
    align-self: flex-start;
    height: 44px;
    width: auto;
  }
  .site-footer__links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 28px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .site-footer__links a {
    color: var(--muted);
  }
</style>
