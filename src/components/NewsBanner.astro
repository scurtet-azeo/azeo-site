---
// Bandeau « News » façon flash info, sous le menu, sur toutes les pages.
// Il fait tourner les 4 dernières actualités, dans un ordre aléatoire à chaque visite,
// chacune affichée 15 secondes. La rotation se met en pause au survol et au clavier.
// Le visiteur peut fermer le bandeau : ce choix est mémorisé jusqu'à la prochaine actualité.
import { getActualites } from '../lib/actualites';

const NB_ACTUS = 4;
const DUREE_SECONDES = 15;
const actus = (await getActualites()).slice(0, NB_ACTUS);
---
{actus.length > 0 && (
  <div
    class="flash"
    hidden
    data-id={actus[0].id}
    data-duree={DUREE_SECONDES * 1000}
    style={`--duree: ${DUREE_SECONDES}s`}
  >
    <div class="container flash__inner">
      <span class="flash__label"><span class="flash__dot" aria-hidden="true"></span>News</span>
      <div class="flash__items">
        {actus.map((a, i) => (
          <a class:list={['flash__link', { 'is-active': i === 0 }]} href={`/actualites/${a.id}/`} inert={i !== 0}>
            <span class="flash__track">
              <span class="flash__text">{a.data.titre}</span>
              <span class="flash__cta">Lire l’actu →</span>
            </span>
          </a>
        ))}
      </div>
      <button class="flash__close" type="button" aria-label="Masquer le bandeau d’actualités">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
      </button>
    </div>
    {actus.length > 1 && <span class="flash__progress" aria-hidden="true"></span>}
  </div>
)}

<script>
  const flash = document.querySelector<HTMLElement>('.flash');
  if (flash) {
    const { id, duree } = flash.dataset;
    let ferme = false;
    try {
      ferme = localStorage.getItem('flash-ferme') === id;
    } catch {}

    if (!ferme) {
      flash.hidden = false;
      const zone = flash.querySelector<HTMLElement>('.flash__items')!;
      const progress = flash.querySelector<HTMLElement>('.flash__progress');

      // Ordre aléatoire (mélange de Fisher-Yates), différent à chaque page vue.
      const liens = [...flash.querySelectorAll<HTMLElement>('.flash__link')];
      for (let i = liens.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [liens[i], liens[j]] = [liens[j], liens[i]];
      }

      // Un titre trop long pour la largeur défile jusqu'à sa fin pendant ses 15 secondes.
      const mesurer = (lien: HTMLElement) => {
        const track = lien.querySelector<HTMLElement>('.flash__track')!;
        const debord = track.scrollWidth - lien.clientWidth;
        lien.classList.remove('is-scrolling');
        if (debord > 2) {
          lien.style.setProperty('--debord', `${-debord}px`);
          void lien.offsetWidth; // relance l'animation depuis le début
          lien.classList.add('is-scrolling');
        }
      };

      let index = 0;
      let barre: Animation | undefined;
      const afficher = (suivant: number) => {
        const actuel = liens[index];
        const nouveau = liens[suivant];
        if (actuel !== nouveau) {
          actuel.classList.remove('is-active');
          actuel.classList.add('is-leaving');
          actuel.inert = true;
          setTimeout(() => actuel.classList.remove('is-leaving', 'is-scrolling'), 500);
        }
        nouveau.classList.add('is-active');
        nouveau.inert = false;
        index = suivant;
        mesurer(nouveau);
        // La barre de progression sert aussi de minuterie : à la fin, on passe à la suivante.
        if (progress && liens.length > 1) {
          barre?.cancel();
          barre = progress.animate([{ transform: 'scaleX(0)' }, { transform: 'scaleX(1)' }], {
            duration: Number(duree),
            easing: 'linear',
          });
          if (zone.matches(':hover, :focus-within')) barre.pause();
          barre.onfinish = () => afficher((index + 1) % liens.length);
        }
      };

      // Premier affichage : la première news du mélange, sans animation d'entrée.
      for (const lien of liens) {
        lien.classList.remove('is-active');
        lien.inert = true;
      }
      afficher(0);

      const pause = () => {
        barre?.pause();
        flash.classList.add('is-paused');
      };
      const reprise = () => {
        if (zone.matches(':hover, :focus-within')) return;
        barre?.play();
        flash.classList.remove('is-paused');
      };
      zone.addEventListener('mouseenter', pause);
      zone.addEventListener('mouseleave', reprise);
      zone.addEventListener('focusin', pause);
      zone.addEventListener('focusout', () => setTimeout(reprise));
      addEventListener('resize', () => mesurer(liens[index]));
    }

    flash.querySelector('.flash__close')?.addEventListener('click', () => {
      flash.hidden = true;
      flash.getAnimations({ subtree: true }).forEach((a) => a.cancel());
      try {
        localStorage.setItem('flash-ferme', id!);
      } catch {}
    });
  }
</script>

<style>
  .flash {
    position: relative;
    background: var(--petrol-deep);
    color: #fff;
    font-size: 0.9375rem;
  }
  .flash[hidden] {
    display: none;
  }
  .flash__inner {
    display: flex;
    align-items: center;
    gap: 14px;
    min-height: 46px;
  }
  .flash__label {
    flex: none;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 28px;
    padding: 0 12px;
    border-radius: 6px;
    background: var(--orange);
    color: var(--ink);
    font-weight: 700;
    font-size: 0.8125rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .flash__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--ink);
    animation: pulse 1.6s ease-in-out infinite;
  }
  @keyframes pulse {
    50% {
      opacity: 0.25;
    }
  }

  /* Les news sont empilées au même endroit ; seule la news active est visible. */
  .flash__items {
    flex: 1;
    min-width: 0;
    display: grid;
    overflow: hidden;
  }
  .flash__link {
    grid-area: 1 / 1;
    min-width: 0;
    overflow: hidden;
    padding: 4px 0;
    color: #fff;
    text-decoration: none;
    white-space: nowrap;
    visibility: hidden;
    transform: translateY(100%);
    transition:
      transform 0.45s cubic-bezier(0.2, 0.7, 0.2, 1),
      visibility 0s linear 0.45s;
  }
  .flash__link.is-active {
    visibility: visible;
    transform: none;
    transition: transform 0.45s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .flash__link.is-leaving {
    transform: translateY(-100%);
  }
  .flash__link:hover {
    color: #fff;
  }
  .flash__link:hover .flash__text {
    text-decoration: underline;
  }
  .flash__track {
    display: inline-flex;
    gap: 14px;
  }
  .flash__text {
    font-weight: 600;
  }
  .flash__cta {
    color: var(--lime);
    font-weight: 600;
  }

  /* Titre long : pause au début, défilement jusqu'à la fin, pause à la fin. */
  .flash__link.is-scrolling {
    -webkit-mask-image: linear-gradient(to right, #000 92%, transparent);
    mask-image: linear-gradient(to right, #000 92%, transparent);
  }
  .is-scrolling .flash__track {
    animation: ticker var(--duree) linear both;
  }
  .is-paused .is-scrolling .flash__track {
    animation-play-state: paused;
  }
  @keyframes ticker {
    0%,
    15% {
      transform: none;
    }
    85%,
    100% {
      transform: translateX(var(--debord));
    }
  }

  /* Barre de progression lime en bas du bandeau, comme sur les chaînes d'info. */
  .flash__progress {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 3px;
    background: var(--lime);
    transform: scaleX(0);
    transform-origin: left;
  }

  .flash__close {
    flex: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border: none;
    border-radius: 50%;
    background: transparent;
    color: var(--on-dark);
    cursor: pointer;
  }
  .flash__close:hover {
    background: rgba(255, 255, 255, 0.1);
    color: #fff;
  }
  @media (prefers-reduced-motion: reduce) {
    /* Pas de mouvement : les news changent toujours toutes les 15 secondes, sans glisser. */
    .flash__dot {
      animation: none;
    }
    .flash__link,
    .flash__link.is-active {
      transform: none;
      transition: none;
    }
    .is-scrolling .flash__track {
      animation: none;
    }
    .flash__link.is-scrolling {
      -webkit-mask-image: none;
      mask-image: none;
    }
    .flash__text {
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .flash__track {
      max-width: 100%;
    }
    .flash__progress {
      opacity: 0;
    }
  }
  @media (max-width: 560px) {
    .flash__cta {
      display: none;
    }
  }
</style>
