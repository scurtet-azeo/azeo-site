---
const steps = [
  { title: 'Diagnostic', text: 'Analyse de votre organisation, de vos règles et de vos indicateurs.' },
  { title: 'Choix de la solution', text: 'Logiciel et badgeuses adaptés à vos équipes et à votre budget.' },
  { title: 'Installation et paramétrage', text: 'Un outil construit sur mesure et intégré à votre paie.' },
  { title: 'Formation', text: 'Gestionnaires, managers et collaborateurs, sur site à La Réunion.' },
  { title: 'Mise en production et maintenance', text: 'Démarrage accompagné, puis support et évolutions dans la durée.' },
];
---
<section id="accompagnement" class="section section--dark">
  <div class="container">
    <div class="acc__head">
      <p class="eyebrow">Notre accompagnement</p>
      <h2>De l’analyse de vos besoins à la maintenance, un seul interlocuteur.</h2>
    </div>
    <ol class="acc__steps">
      {steps.map((s, i) => (
        <li>
          <span class="acc__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <h3>{s.title}</h3>
          <p>{s.text}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .acc__head {
    display: flex;
    flex-direction: column;
    gap: 16px;
    max-width: 820px;
    margin-bottom: clamp(36px, 5vw, 56px);
  }
  .acc__steps {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 20px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .acc__steps li {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding-top: 22px;
    border-top: 2px solid var(--lime);
  }
  .acc__num {
    font-family: var(--font-display);
    font-size: 2.25rem;
    font-weight: 500;
    color: var(--lime);
    line-height: 1;
  }
  .acc__steps p {
    font-size: 0.9375rem;
    color: var(--on-dark);
  }
  @media (max-width: 1080px) {
    .acc__steps {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  @media (max-width: 640px) {
    .acc__steps {
      grid-template-columns: 1fr;
    }
    .acc__steps li {
      display: grid;
      grid-template-columns: 48px 1fr;
      column-gap: 12px;
      row-gap: 4px;
    }
    .acc__num {
      grid-row: span 2;
      font-size: 1.5rem;
    }
  }
</style>
