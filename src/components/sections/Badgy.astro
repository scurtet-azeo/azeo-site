---
import { Image } from 'astro:assets';
import Icon from '../Icon.astro';
import badgy from '../../assets/badgy.png';

const features = [
  { icon: 'badge', title: 'Une vraie badgeuse', text: 'Vos collaborateurs utilisent exactement les mêmes badges que sur vos terminaux Horoquartz. Zéro changement d’habitude.' },
  { icon: 'tablet', title: 'Déployée à moindre coût', text: 'Une simple tablette Android suffit. Plus besoin d’investir dans un terminal dédié pour chaque site.' },
  { icon: 'sites', title: 'Tous vos sites, même éphémères', text: 'Sites multiples, foires, expositions, chantiers : la badgeuse vient là où sont vos équipes.' },
  { icon: 'sync', title: 'Même sans réseau', text: 'Les pointages sont sauvegardés et remontés automatiquement dès le retour de la connexion.' },
  { icon: 'lead', title: 'Sur le smartphone des chefs d’équipe', text: 'Idéal pour les équipes mobiles et les chantiers : le badgeage se fait directement sur le terrain.' },
  { icon: 'pin', title: 'Géolocalisation et NFC', text: 'Chaque pointage est géolocalisé, et le lieu lui-même peut être identifié par un badge NFC.' },
] as const;
---
<section id="badgy" class="section section--dark" aria-labelledby="badgy-titre">
  <div class="container">
    <div class="badgy__top">
      <div class="badgy__intro">
        <span class="badgy__new">Nouveau</span>
        <h2 id="badgy-titre" class="badgy__title">Badgy <span>by Azéo</span></h2>
        <p class="badgy__tagline">La badgeuse connectée qui s’adapte à tous vos sites.</p>
        <p class="lead">
          Notre application de badgeage sur tablette et smartphone, 100 % compatible avec
          eTemptation d’Horoquartz. Une simple tablette Android devient une badgeuse
          professionnelle.
        </p>
        <div class="badgy__cta">
          <a href="#contact" class="btn btn--lime">Demander une démo</a>
          <p>Vous utilisez déjà eTemptation ?<br />Parlons-en.</p>
        </div>
      </div>

      <div class="badgy__visual">
        <Image
          src={badgy}
          alt="L’application Badgy sur une tablette et un smartphone équipés d’un lecteur de badge, avec une carte collaborateur Azéo"
          widths={[320, 532]}
          sizes="(max-width: 1024px) 80vw, 420px"
          loading="lazy"
        />
      </div>
    </div>

    <ul class="badgy__features">
      {features.map((f) => (
        <li>
          <Icon name={f.icon} size={28} color="var(--lime)" />
          <h3>{f.title}</h3>
          <p>{f.text}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .badgy__top {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(40px, 6vw, 72px);
    align-items: center;
  }
  .badgy__intro {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .badgy__new {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    height: 30px;
    padding: 0 14px;
    border-radius: 999px;
    background: var(--orange);
    color: var(--ink);
    font-size: 0.875rem;
    font-weight: 700;
  }
  .badgy__title {
    font-size: clamp(2.5rem, 5.5vw, 4rem);
    font-weight: 700;
    line-height: 1.02;
    letter-spacing: -0.02em;
  }
  .badgy__title span {
    color: var(--lime);
  }
  .badgy__tagline {
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 2.2vw, 1.75rem);
    font-weight: 500;
    line-height: 1.25;
  }
  .badgy__cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px;
    padding-top: 4px;
  }
  .badgy__cta p {
    font-size: 0.9375rem;
    color: var(--on-dark);
  }
  .badgy__visual {
    justify-self: center;
    width: min(100%, 460px);
    background: #fff;
    border-radius: 28px;
    padding: clamp(20px, 3vw, 36px);
  }
  .badgy__visual :global(img) {
    width: 100%;
    height: auto;
  }
  .badgy__features {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
    margin: clamp(48px, 6vw, 64px) 0 0;
    padding: 0;
    list-style: none;
  }
  .badgy__features li {
    background: var(--petrol-card);
    border-radius: var(--radius-m);
    padding: 28px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .badgy__features h3 {
    font-size: 1.1875rem;
  }
  .badgy__features p {
    font-size: 0.9375rem;
    color: var(--on-dark);
  }
  @media (max-width: 1024px) {
    .badgy__top {
      grid-template-columns: 1fr;
    }
    .badgy__features {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 600px) {
    .badgy__features {
      grid-template-columns: 1fr;
    }
    .badgy__features li {
      padding: 20px;
    }
  }
</style>
