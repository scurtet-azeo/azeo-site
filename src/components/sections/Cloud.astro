---
import { Image } from 'astro:assets';
import Icon from '../Icon.astro';
import exodataLogo from '../../assets/exodata.png';

const exodataUrl = 'https://www.exodata.fr/cloud';
const proofs = [
  { label: 'HDS', text: 'Datacenter certifié Hébergeur de Données de Santé' },
  { label: 'Hébergement local', text: 'Cloud privé hébergé à La Réunion' },
  { label: 'ISO 27001', text: 'Sécurité de l’information certifiée, infogérance Exodata' },
  { label: 'ISO 9001', text: 'Management de la qualité certifié, infogérance Exodata' },
];
---
<section id="cloud" class="section">
  <div class="container">
    <div class="cloud">
      <div class="cloud__text">
        <p class="eyebrow cloud__eyebrow">Hébergement</p>
        <h2>Un cloud privé, hébergé à La Réunion</h2>
        <p class="lead">
          Vos solutions Azéo Conseil sont hébergées localement, au sein de l’infrastructure cloud
          privée d’Exodata.
        </p>
        <p class="lead">
          Vos données restent hébergées à La Réunion, dans un environnement sécurisé et opéré
          localement, pour conjuguer proximité, performance et maîtrise de vos données.
        </p>
        <div class="cloud__partner">
          <span>Infrastructure opérée par</span>
          <Image src={exodataLogo} alt="Exodata" height={44} densities={[1, 2]} class="cloud__partner-logo" />
        </div>
        <div class="cloud__actions">
          <a href="#contact" class="btn btn--ink">Parler de l’hébergement</a>
          <a href={exodataUrl} class="btn btn--outline" rel="noopener">
            En savoir plus sur Exodata <Icon name="external" size={18} />
          </a>
        </div>
      </div>
      <ul class="cloud__proofs">
        {proofs.map((p) => (
          <li>
            <strong>{p.label}</strong>
            <span>{p.text}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .cloud {
    background: var(--bg-cloud);
    border-radius: 28px;
    padding: clamp(28px, 5vw, 72px);
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(32px, 5vw, 72px);
    align-items: center;
  }
  .cloud__text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;
  }
  .cloud__eyebrow {
    color: var(--petrol-hover);
  }
  .cloud__text .lead {
    color: #2f3a37;
  }
  /* Logo du partenaire, sur fond blanc pour garder le contraste de la sphère grise. */
  .cloud__partner {
    display: inline-flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px 16px;
    padding: 10px 20px;
    background: #fff;
    border-radius: var(--radius-m);
    font-size: 0.875rem;
    color: var(--muted);
  }
  .cloud__partner-logo {
    height: 44px;
    width: auto;
  }
  .cloud__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .cloud__proofs {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .cloud__proofs li {
    background: #fff;
    border-radius: var(--radius-m);
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .cloud__proofs strong {
    font-family: var(--font-display);
    font-size: clamp(1.375rem, 2.2vw, 1.875rem);
    font-weight: 600;
    line-height: 1.15;
    color: var(--petrol-hover);
  }
  .cloud__proofs span {
    font-size: 0.9375rem;
    line-height: 1.5;
    color: var(--text);
  }
  @media (max-width: 960px) {
    .cloud {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 420px) {
    .cloud__proofs {
      grid-template-columns: 1fr;
    }
  }
</style>
