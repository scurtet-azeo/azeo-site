---
import { Image } from 'astro:assets';
import Icon from '../Icon.astro';
import temly from '../../assets/temly-scene.jpg';

const features = [
  { icon: 'badge', title: 'Une vraie badgeuse', text: 'Vos collaborateurs utilisent exactement les mêmes badges que sur vos badgeuses Horoquartz. Zéro changement d’habitude.' },
  { icon: 'tablet', title: 'Déployée à moindre coût', text: 'Une simple tablette Android suffit. Plus besoin d’investir dans une badgeuse dédiée pour chaque site.' },
  { icon: 'sites', title: 'Tous vos sites, même éphémères', text: 'Sites multiples, foires, expositions, chantiers : la badgeuse vient là où sont vos équipes.' },
  { icon: 'sync', title: 'Même sans réseau', text: 'Les badgeages sont sauvegardés et remontés automatiquement dès le retour de la connexion.' },
  { icon: 'lead', title: 'La badgeuse de toute l’équipe', text: 'Le chef d’équipe identifie le lieu, dans une liste ou en scannant un badge NFC posé sur place. Son smartphone devient alors la badgeuse de toute l’équipe.' },
  { icon: 'pin', title: 'Géolocalisation intégrée', text: 'Chaque badgeage est géolocalisé et rattaché au bon lieu, pour un suivi fiable des présences.' },
] as const;
---
<section id="temly" class="section section--dark" aria-labelledby="temly-titre">
  <div class="container">
    <div class="temly__top">
      <div class="temly__intro">
        <span class="temly__new">Nouveau</span>
        <h2 id="temly-titre" class="temly__title">Temly <span>by Azéo</span></h2>
        <p class="temly__tagline">La badgeuse connectée qui s’adapte à tous vos sites</p>
        <p class="lead">
          Notre application de badgeage sur tablette et smartphone, 100 % compatible avec
          eTemptation d’Horoquartz. Une simple tablette Android devient une badgeuse
          professionnelle.
        </p>
        <div class="temly__cta">
          <a href="#contact" class="btn btn--lime">Demander une démo</a>
          <p>Vous utilisez déjà eTemptation ?<br />Parlons-en.</p>
        </div>
      </div>

      <div class="temly__visual">
        <Image
          src={temly}
          alt="L’application Temly sur une tablette et un smartphone équipés d’un lecteur de badge, avec une carte collaborateur Azéo"
          widths={[480, 800, 1200]}
          sizes="(max-width: 1024px) 90vw, 560px"
          loading="lazy"
        />
      </div>
    </div>

    <ul class="temly__features">
      {features.map((f) => (
        <li>
          <Icon name={f.icon} size={28} color="var(--lime)" />
          <h3>{f.title}</h3>
          <p>{f.text}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .temly__top {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(40px, 6vw, 72px);
    align-items: center;
  }
  .temly__intro {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .temly__new {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    height: 30px;
    padding: 0 14px;
    border-radius: 999px;
    background: var(--orange);
    color: var(--ink);
    font-size: 0.875rem;
    font-weight: 700;
  }
  .temly__title {
    font-size: clamp(2.5rem, 5.5vw, 4rem);
    font-weight: 700;
    line-height: 1.02;
    letter-spacing: -0.02em;
  }
  .temly__title span {
    color: var(--lime);
  }
  .temly__tagline {
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 2.2vw, 1.75rem);
    font-weight: 500;
    line-height: 1.25;
  }
  .temly__cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px;
    padding-top: 4px;
  }
  .temly__cta p {
    font-size: 0.9375rem;
    color: var(--on-dark);
  }
  .temly__visual {
    justify-self: center;
    width: min(100%, 580px);
  }
  .temly__visual :global(img) {
    width: 100%;
    height: auto;
    border-radius: 28px;
    box-shadow: 0 30px 60px rgba(0, 0, 0, 0.25);
  }
  .temly__features {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
    margin: clamp(48px, 6vw, 64px) 0 0;
    padding: 0;
    list-style: none;
  }
  .temly__features li {
    background: var(--petrol-card);
    border-radius: var(--radius-m);
    padding: 28px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .temly__features h3 {
    font-size: 1.1875rem;
  }
  .temly__features p {
    font-size: 0.9375rem;
    color: var(--on-dark);
  }
  @media (max-width: 1024px) {
    .temly__top {
      grid-template-columns: 1fr;
    }
    .temly__features {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 600px) {
    .temly__features {
      grid-template-columns: 1fr;
    }
    .temly__features li {
      padding: 20px;
    }
  }
</style>
