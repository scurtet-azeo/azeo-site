---
import { temoignages } from '../../data/temoignages';
const t = temoignages[0];
---
{t && (
  <section class="section" aria-label="Témoignage client">
    <div class="container">
      <figure class="quote">
        <blockquote>« {t.quote} »</blockquote>
        <figcaption>
          <strong>{t.name}</strong>
          <span>{t.role}</span>
        </figcaption>
      </figure>
    </div>
  </section>
)}

<style>
  .quote {
    margin: 0;
    background: var(--bg-alt);
    border-radius: var(--radius-l);
    padding: clamp(28px, 5vw, 64px) clamp(24px, 5vw, 72px);
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 32px 48px;
    align-items: center;
  }
  blockquote {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.375rem, 2.6vw, 2rem);
    line-height: 1.35;
  }
  figcaption {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  figcaption span {
    color: var(--muted);
    font-size: 0.9375rem;
  }
  @media (max-width: 800px) {
    .quote {
      grid-template-columns: 1fr;
    }
  }
</style>
