---
// Gabarit des pages de texte (mentions légales, confidentialité…).
import Base from './Base.astro';
interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
}
const { title, description, noindex } = Astro.props;
---
<Base title={title} description={description} noindex={noindex}>
  <article class="section">
    <div class="container prose">
      <h1>{title}</h1>
      <slot />
    </div>
  </article>
</Base>

<style>
  .prose {
    max-width: calc(760px + 2 * var(--gutter));
  }
  .prose :global(h1) {
    font-size: clamp(2rem, 4vw, 3rem);
    margin-bottom: 32px;
  }
  .prose :global(h2) {
    font-size: 1.5rem;
    margin: 40px 0 12px;
  }
  .prose :global(p),
  .prose :global(li) {
    color: var(--text);
    max-width: 70ch;
  }
  .prose :global(p + p) {
    margin-top: 12px;
  }
  .prose :global(h2 + p) {
    margin-top: 0;
  }
  .prose :global(table) {
    width: 100%;
    max-width: 70ch;
    border-collapse: collapse;
    margin-top: 8px;
    font-size: 0.9375rem;
  }
  .prose :global(th),
  .prose :global(td) {
    text-align: left;
    vertical-align: top;
    padding: 12px 14px;
    border: 1px solid var(--line);
    color: var(--text);
  }
  .prose :global(th) {
    background: var(--bg-alt);
    color: var(--ink);
  }
  .prose :global(address) {
    font-style: normal;
    color: var(--text);
  }
</style>
