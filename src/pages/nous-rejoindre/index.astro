---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { site } from '../../data/site';
import { offresOuvertes } from '../../data/offres';

const candidatureSpontanee = `mailto:${site.recrutementEmail}?subject=${encodeURIComponent(
  'Candidature spontanée',
)}`;

const formatDate = (d: string) =>
  new Date(d).toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' });

// Arguments « pourquoi nous rejoindre » : à ajuster selon votre réalité.
const raisons = [
  { icon: 'pin', title: 'Une équipe ancrée ici', text: 'Un bureau à Saint-Leu, des clients à La Réunion et à Mayotte, et des décisions prises localement.' },
  { icon: 'sites', title: 'Des clients variés', text: 'Grande distribution, collectivités, industrie, santé : chaque projet a ses règles et ses défis.' },
  { icon: 'team', title: 'Du concret, au contact', text: 'Vous suivez les projets de bout en bout, du diagnostic à la mise en production, aux côtés des équipes clientes.' },
  { icon: 'clock', title: 'Un métier qui a du sens', text: 'Des plannings plus justes et une paie fiable : votre travail simplifie le quotidien de milliers de salariés.' },
] as const;
---
<Base
  title="Nous rejoindre : offres d’emploi à La Réunion"
  description="Rejoignez Azéo Conseil à Saint-Leu : offres d’emploi en gestion des temps, paramétrage eTemptation et support, et candidatures spontanées."
>
  <section class="rj-hero">
    <div class="container">
      <nav class="crumbs" aria-label="Fil d’Ariane">
        <a href="/">Accueil</a> <span aria-hidden="true">/</span> <span aria-current="page">Nous rejoindre</span>
      </nav>
      <div class="stack rj-hero__text">
        <p class="eyebrow">Recrutement</p>
        <h1>Rejoignez une équipe engagée, ici à La Réunion</h1>
        <p class="lead">
          Chez Azéo Conseil, nous aidons depuis 2009 les entreprises et les collectivités de l’océan
          Indien à mieux gérer le temps de leurs équipes. Envie de faire partie de l’aventure ?
        </p>
      </div>
    </div>
  </section>

  <section class="section section--alt" aria-labelledby="offres-titre">
    <div class="container">
      {offresOuvertes.length > 0 ? (
        <>
          <div class="stack offres__head">
            <p class="eyebrow">Nos offres</p>
            <h2 id="offres-titre">
              {offresOuvertes.length === 1 ? '1 poste ouvert' : `${offresOuvertes.length} postes ouverts`}
            </h2>
          </div>
          <ul class="offres">
            {offresOuvertes.map((o) => (
              <li class="card offre">
                <p class="offre__meta">{[o.contrat, o.lieu].filter(Boolean).join(' · ')}</p>
                <h3>{o.titre}</h3>
                <p>{o.resume}</p>
                <p class="offre__date">Publiée le {formatDate(o.publiee)}</p>
                <a href={`/nous-rejoindre/${o.slug}/`} class="link-arrow offre__link">
                  Voir l’offre <Icon name="arrow" size={18} />
                </a>
              </li>
            ))}
          </ul>
          <p class="offres__spontanee">
            Aucun poste ne correspond à votre profil ?
            <a href={candidatureSpontanee}>Envoyez-nous une candidature spontanée</a>.
          </p>
        </>
      ) : (
        <div class="closed">
          <div class="closed__clock" aria-hidden="true">
            <svg viewBox="0 0 120 120" width="120" height="120">
              <circle cx="60" cy="60" r="52" fill="none" stroke="var(--lime)" stroke-width="8" />
              <path d="M60 8 A52 52 0 0 1 112 60" fill="none" stroke="var(--orange)" stroke-width="8" stroke-linecap="round" />
              <line class="hand hand--hour" x1="60" y1="60" x2="60" y2="36" stroke="var(--petrol)" stroke-width="7" stroke-linecap="round" />
              <line class="hand hand--minute" x1="60" y1="60" x2="60" y2="22" stroke="var(--ink)" stroke-width="4" stroke-linecap="round" />
              <circle cx="60" cy="60" r="6" fill="var(--petrol)" />
            </svg>
          </div>
          <div class="stack closed__text">
            <p class="eyebrow">Nos offres</p>
            <h2 id="offres-titre">Pas de poste ouvert… pour l’instant !</h2>
            <p class="lead">
              Notre équipe est au complet en ce moment. Mais les belles rencontres n’attendent pas
              toujours une offre : envoyez-nous votre CV, nous le lirons avec attention et
              reviendrons vers vous dès qu’une opportunité se présente.
            </p>
            <div class="closed__actions">
              <a href={candidatureSpontanee} class="btn btn--primary">Envoyer ma candidature spontanée</a>
              {site.linkedin && (
                <a href={site.linkedin} class="btn btn--outline" rel="noopener">Suivre nos offres sur LinkedIn</a>
              )}
            </div>
          </div>
        </div>
      )}
    </div>
  </section>

  <section class="section" aria-labelledby="raisons-titre">
    <div class="container">
      <div class="stack raisons__head">
        <p class="eyebrow">Pourquoi nous rejoindre</p>
        <h2 id="raisons-titre">Un métier utile, au plus près du terrain</h2>
      </div>
      <ul class="raisons">
        {raisons.map((r) => (
          <li>
            <Icon name={r.icon} size={30} color="var(--petrol)" />
            <h3>{r.title}</h3>
            <p>{r.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Base>

<style>
  .crumbs {
    font-size: 0.875rem;
    color: var(--muted);
    margin-bottom: 20px;
  }
  .crumbs a {
    color: var(--muted);
  }
  .rj-hero {
    padding-block: clamp(32px, 5vw, 72px) clamp(40px, 5vw, 72px);
  }
  .rj-hero__text {
    gap: 22px;
    max-width: 820px;
  }
  .rj-hero__text h1 {
    font-size: clamp(2.25rem, 4.4vw, 3.5rem);
  }

  /* Liste des offres */
  .offres__head {
    margin-bottom: 32px;
  }
  .offres {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 340px), 1fr));
    gap: 20px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .offre h3 {
    font-size: 1.375rem;
  }
  .offre__meta {
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--orange-text);
  }
  .offre__date {
    font-size: 0.875rem;
  }
  .offre__link {
    margin-top: auto;
  }
  .offres__spontanee {
    margin-top: 28px;
    color: var(--text);
  }

  /* Aucune offre : message avec horloge animée */
  .closed {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: clamp(28px, 5vw, 64px);
    align-items: center;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: var(--radius-l);
    padding: clamp(28px, 5vw, 64px);
  }
  .closed__clock svg {
    width: clamp(96px, 14vw, 160px);
    height: auto;
  }
  .hand {
    transform-origin: 60px 60px;
  }
  .hand--minute {
    animation: tour 6s linear infinite;
  }
  .hand--hour {
    animation: tour 72s linear infinite;
  }
  @keyframes tour {
    to {
      transform: rotate(360deg);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hand {
      animation: none;
    }
  }
  .closed__text {
    gap: 18px;
  }
  .closed__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    padding-top: 6px;
  }

  /* Pourquoi nous rejoindre */
  .raisons__head {
    margin-bottom: clamp(32px, 5vw, 48px);
  }
  .raisons {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 24px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .raisons li {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding-top: 22px;
    border-top: 2px solid var(--ink);
  }
  .raisons p {
    color: var(--muted);
    font-size: 1rem;
  }
  @media (max-width: 960px) {
    .raisons {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 640px) {
    .closed {
      grid-template-columns: 1fr;
      justify-items: start;
    }
    .raisons {
      grid-template-columns: 1fr;
    }
  }
</style>
